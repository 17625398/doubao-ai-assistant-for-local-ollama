{
  "manifest_version": 3,
  "name": "豆包 AI 工作台",
  "version": "2.8.7",
  "description": "本地原生 AI 助手：侧边栏、网页阅读、文档理解、搜索、创作、Canvas Artifact 与诊断桥接。",
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "sidePanel",
    "scripting",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "bookmarks"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "豆包 AI 工作台",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/preinject.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/content-script.js"],
      "exclude_matches": [
        "https://www.doubao.com/chat/**",
        "https://www.cici.com/chat/**",
        "https://www.ciciai.com/chat/**",
        "https://www.dola.com/chat/**"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "externally_connectable": {
    "matches": [
      "https://*.doubao.com/*",
      "https://*.cici.com/*",
      "https://*.ciciai.com/*",
      "https://*.dola.com/*",
      "https://*.larkoffice.com/*",
      "https://*.feishu.cn/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "css/*", "js/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
