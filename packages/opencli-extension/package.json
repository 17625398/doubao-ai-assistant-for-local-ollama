{
  "name": "@ai-intelligent-analysis-platform/opencli-extension",
  "version": "1.5.5",
  "description": "OpenCLI Browser automation bridge - Executes commands in isolated Chrome windows via a local daemon.",
  "type": "module",
  "main": "dist/src/main.js",
  "bin": {
    "opencli": "dist/src/main.js"
  },
  "scripts": {
    "dev": "webpack --mode=development --watch",
    "build": "npm run clean && tsc && webpack --mode=production",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "if exist dist rmdir /s /q dist"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "ora": "^9.3.0",
    "turndown": "^7.2.2",
    "undici": "^7.24.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.263",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.0",
    "prettier": "^3.8.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}