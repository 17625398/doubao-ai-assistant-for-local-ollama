{
  "name": "ai-intelligent-analysis-platform",
  "version": "2.2.0",
  "description": "AI智能分析平台 - 浏览器扩展与桌面应用 - Lightpanda浏览器集成版",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"java -Dlinkmind.config=config/lagi.yml -jar ../linkmind-server/lagi-web/target/LinkMind.jar\" \"turbo run dev --concurrency=8\"",
    "dev:web": "concurrently --kill-others-on-fail \"java -Dlinkmind.config=config/lagi.yml -jar ../linkmind-server/lagi-web/target/LinkMind.jar\" \"cd packages/web && npm run dev\"",
    "start:linkmind": "java -Dlinkmind.config=config/lagi.yml -jar ../linkmind-server/lagi-web/target/LinkMind.jar",
    "build": "turbo run build --concurrency=2",
    "build:core": "cd packages/core && npm run build",
    "build:extension": "cd packages/extension && npm run build",
    "build:opencli": "cd packages/opencli-extension && npm run build",
    "build:page-assist": "cd packages/page-assist && npm run build",
    "build:world-monitor": "cd packages/world-monitor && npm run build",
    "build:web": "cd packages/web && npm run build",
    "package:web": "npm run build:web && cd packages/web && npm run package:standalone",
    "package:web:zip": "npm run build:web && cd packages/web && npm run package:zip",
    "package:web:win": "npm run package:web:zip",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "clean": "turbo run clean --concurrency=2",
    "security-audit": "npm audit && cd packages/core && npm test -- src/__tests__/security/"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3",
    "undici-types": "^7.24.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@jackwener/opencli": "^1.6.3",
    "bluebird": "^3.7.2",
    "mammoth": "^1.12.0",
    "node-fetch": "^3.3.2",
    "xlsx": "^0.18.5",
    "xmlbuilder": "^15.1.1",
    "zustand": "^5.0.12"
  }
}